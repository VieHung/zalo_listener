discover/

# ── Bí mật / cấu hình cục bộ ─────────────────────────────────────────────
# Service account Google (credentials)
service_account.json
*service_account*.json
credentials*.json
# State của module đồng bộ sheets
*.state.json
sheets_sync.state.json

# ── Hệ điều hành / editor ────────────────────────────────────────────────
.DS_Store
*.swp
.idea/
.vscode/
