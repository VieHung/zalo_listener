# ── Môi trường Python ────────────────────────────────────────────────────
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ── Dữ liệu & runtime nhạy cảm (KHÔNG commit) ────────────────────────────
# Database chứa tin nhắn thật, lock file
data/
# Profile Brave: cookies, session đăng nhập Zalo, cache
.runtime/
